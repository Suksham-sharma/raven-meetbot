# Media worker — transcode + diarize. Needs ffmpeg on PATH (the image installs it).

REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meetbot

# Batch diarization.
DEEPGRAM_API_KEY=

# ffmpeg saturates several cores per encode, so keep these low.
TRANSCODE_WORKER_CONCURRENCY=1
DIARIZE_WORKER_CONCURRENCY=1
# An encode outlives BullMQ's default 30s lock.
TRANSCODE_LOCK_MS=1800000

# Enqueue memory ingest once the named transcript is written.
INGEST_AFTER_DIARIZE=true

# Artifact store. Falls back to RECORDINGS_DIR when R2_ENDPOINT is unset —
# must match api-server and bot, or they read and write in different places.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=meeting-recordings
R2_REGION=auto
RECORDINGS_DIR=
