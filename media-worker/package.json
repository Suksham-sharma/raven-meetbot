{
  "name": "meet-bot-media-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "worker:transcode": "tsx src/transcode/worker.ts",
    "worker:transcode:dev": "tsx watch src/transcode/worker.ts",
    "worker:diarize": "tsx src/diarize/worker.ts",
    "worker:diarize:dev": "tsx watch src/diarize/worker.ts",
    "transcode": "tsx src/cli/transcode.ts",
    "diarize": "tsx src/cli/diarize.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@deepgram/sdk": "^5.7.0",
    "bullmq": "^5.53.2",
    "dotenv": "^16.4.7",
    "fluent-ffmpeg": "^2.1.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  }
}
