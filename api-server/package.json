{
  "name": "meet-bot-api-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "worker:memory": "tsx src/workers/memory.worker.ts",
    "worker:memory:dev": "tsx watch src/workers/memory.worker.ts",
    "worker:agent": "tsx src/workers/agent.worker.ts",
    "worker:agent:dev": "tsx watch src/workers/agent.worker.ts",
    "propose": "tsx src/cli/propose.ts",
    "seed:owner": "tsx src/cli/seedOwner.ts",
    "ingest:seed": "tsx src/cli/ingest.ts",
    "enqueue:seed": "tsx src/cli/enqueueSeeds.ts",
    "gen:seed": "tsx src/cli/genTranscript.ts",
    "search": "tsx src/cli/search.ts",
    "ask": "tsx src/cli/ask.ts",
    "eval:retrieval": "tsx src/eval/retrieval.ts",
    "eval:answer": "tsx src/eval/answer.ts",
    "eval:evidence": "tsx src/eval/evidence.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "bullmq": "^5.53.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "jose": "^5.9.6",
    "openai": "^6.44.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  }
}
